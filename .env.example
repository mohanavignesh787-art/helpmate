# GEMINI_API_KEY: Required for Gemini AI API calls (Task Analyzer, Safety Check, Assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# GOOGLE_MAPS_API_KEY: Optional. Your Google Maps JavaScript & Routes API Key.
# If omitted, HelpMate gracefully falls back to interactive simulated high-precision vector maps.
GOOGLE_MAPS_API_KEY=

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional Razorpay credentials for payment gateway integration.
# HelpMate includes built-in secure escrow simulation & verification when keys are in test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
